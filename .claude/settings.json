      "Bash(git commit *)",
      "Bash(git config *)",
      "Bash(git fetch *)",
      "Bash(git gc *)",
      "Bash(git merge *)",
      "Bash(git mv *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git rm *)",
      "Bash(git stash *)",      
      "Bash(git switch *)",
      "Bash(git tag *)",
      "Bash(git update-ref *)",
      "Edit(.git/**)",
      "Write(.git/**)"
    ]
